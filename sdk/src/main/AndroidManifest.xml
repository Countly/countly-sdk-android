<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- the Meta Install Referrer is read from these apps (CountlyConfig.setFacebookAppId); only then -->
  <queries>
    <package android:name="com.facebook.katana"/>
    <package android:name="com.instagram.android"/>
    <package android:name="com.facebook.lite"/>
  </queries>

  <application>
    <activity
        android:name=".messaging.CountlyPushActivity"
        android:excludeFromRecents="true"
        android:noHistory="true"
        android:taskAffinity=".CountlyPushActivity"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        android:exported="false"/>

    <provider
        android:name="ly.count.android.sdk.CountlyInitProvider"
        android:authorities="${applicationId}.countlyInitProvider"
        android:exported="false"/>
  </application>

  <permission
      android:name="${applicationId}.CountlyPush.BROADCAST_PERMISSION"
      android:protectionLevel="signature"/>

</manifest>
